{
  "name": "@twinklerg/coden",
  "version": "0.1.9",
  "description": "A hackable coding agent built around pluggable tool plugins",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/plugin/index.js",
    "dist/plugin/index.d.ts"
  ],
  "bin": {
    "coden": "dist/index.js"
  },
  "exports": {
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    }
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "build": "rm -rf dist && mkdir -p dist/plugin && bun build src/cli/index.ts --target=node --minify --outfile dist/index.js && bun build src/plugin/index.ts --target=node --format=esm --minify --outfile dist/plugin/index.js && tsc -p tsconfig.plugin.json && sed -i.bak '1s|^#!.*|#!/usr/bin/env node|' dist/index.js && rm -f dist/index.js.bak",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "ink": "7.1.1",
    "marked": "^18.0.11",
    "openai": "^5.16.0",
    "picocolors": "^1.1.1",
    "react": "^19.2.0",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "patchedDependencies": {
    "ink@7.1.1": "patches/ink@7.1.1.patch"
  }
}