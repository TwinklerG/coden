{
  "name": "@twinklerg/coden",
  "version": "0.1.0",
  "description": "A minimal event-driven coding agent",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "dist/index.js",
    "README.md"
  ],
  "bin": {
    "coden": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugins/api.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "build": "mkdir -p dist && bun build src/cli/index.ts --target=node --outfile dist/index.js && sed -i.bak '1s|^#!.*|#!/usr/bin/env node|' dist/index.js && rm -f dist/index.js.bak",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "openai": "^5.16.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
