{
  "name": "coden",
  "version": "0.1.0",
  "description": "A minimal event-driven coding agent",
  "type": "module",
  "bin": {
    "coden": "./src/cli/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "openai": "^5.16.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
