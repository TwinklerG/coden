# Provider configuration
CODEN_PROVIDER=openai
CODEN_MODEL=gpt-5-mini
CODEN_MAX_STEPS=20

# OpenAI-compatible provider
CODEN_OPENAI_API_KEY=your-openai-api-key
# CODEN_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic provider (set CODEN_PROVIDER=anthropic to use)
# CODEN_ANTHROPIC_API_KEY=your-anthropic-api-key
