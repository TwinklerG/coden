---
import "../styles/global.css";
import { routeFor } from "../lib/routes";
import { SITE_ORIGIN, withBase } from "../lib/site";
import { messages } from "../i18n/messages";

const zhTarget = routeFor("zh", "home");
const enTarget = routeFor("en", "home");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{messages.en.shell.rootTitle} · CodeN</title>
    <meta name="description" content={messages.en.shell.rootDescription} />
    <link rel="canonical" href={new URL(withBase("/"), SITE_ORIGIN).toString()} />
  </head>
  <body class="root-language-page" data-zh-target={zhTarget} data-en-target={enTarget}>
    <main class="root-language-card">
      <h1>CodeN</h1>
      <p>{messages.en.shell.rootDescription}</p>
      <nav class="root-language-links" aria-label="Language selection">
        <a href={routeFor("zh", "home")}>中文</a>
        <a href={routeFor("en", "home")}>English</a>
      </nav>
      <noscript>
        <p>{messages.en.shell.rootDescription}</p>
      </noscript>
    </main>
    <script>
      const zhTarget = document.body.dataset.zhTarget;
      const enTarget = document.body.dataset.enTarget;
      const languages = navigator.languages?.length > 0 ? navigator.languages : [navigator.language];
      const zhIndex = languages.findIndex((language) => String(language).toLowerCase().startsWith("zh"));
      const enIndex = languages.findIndex((language) => String(language).toLowerCase().startsWith("en"));
      const target = zhIndex !== -1 && (enIndex === -1 || zhIndex < enIndex) ? zhTarget : enTarget;

      if (target && location.pathname !== target) {
        location.replace(target);
      }
    </script>
  </body>
</html>
