---
import Seo from "../components/Seo.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { messages } from "../i18n/messages";
import type { ProductSection } from "../lib/routes";
import type { Language } from "../lib/site";
import "../styles/global.css";

interface Props {
  language: Language;
  title: string;
  description: string;
  section: ProductSection;
}

const { language, title, description, section } = Astro.props;
const currentMessages = messages[language];
const pathname = Astro.url.pathname;
---

<html lang={language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo language={language} title={title} description={description} pathname={pathname} />
    <script is:inline>
      (() => {
        // Shared key with Starlight (docs) so the two surfaces stay in sync.
        const storageKey = "starlight-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: light)");

        const parseTheme = (value) =>
          value === "auto" || value === "light" || value === "dark" ? value : "auto";

        const readTheme = () => {
          let stored = null;
          try {
            stored = window.localStorage.getItem(storageKey);
            // Migrate the previous product-site key so a prior light/dark choice carries over.
            if (stored === null) {
              const legacy = window.localStorage.getItem("coden-theme");
              if (legacy === "light" || legacy === "dark") {
                stored = legacy;
                window.localStorage.setItem(storageKey, stored);
              }
            }
          } catch {
            // Ignore storage failures.
          }
          return parseTheme(stored);
        };

        const systemTheme = () => (media.matches ? "light" : "dark");

        const applyTheme = (preference) => {
          const resolved = preference === "auto" ? systemTheme() : preference;
          root.setAttribute("data-theme", resolved);
          // Expose the raw preference so the header select can set its value at parse time.
          root.setAttribute("data-theme-pref", preference);
          root.style.colorScheme = resolved;
          document.querySelectorAll("[data-theme-select]").forEach((select) => {
            select.value = preference;
          });
        };

        const storeTheme = (preference) => {
          try {
            window.localStorage.setItem(storageKey, preference === "auto" ? "" : preference);
          } catch {
            // Ignore storage failures.
          }
        };

        applyTheme(readTheme());

        document.addEventListener("change", (event) => {
          const select =
            event.target instanceof Element ? event.target.closest("[data-theme-select]") : null;
          if (select instanceof HTMLSelectElement) {
            const next = parseTheme(select.value);
            storeTheme(next);
            applyTheme(next);
          }
        });

        if (typeof media.addEventListener === "function") {
          media.addEventListener("change", () => {
            if (readTheme() === "auto") {
              applyTheme("auto");
            }
          });
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{currentMessages.a11y.skipToContent}</a>
    <SiteHeader language={language} pathname={pathname} section={section} />
    <main id="main-content" class="page-shell">
      <slot />
    </main>
    <SiteFooter language={language} />
  </body>
</html>
