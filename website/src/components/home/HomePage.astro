---
import ProductLayout from "../../layouts/ProductLayout.astro";
import { messages } from "../../i18n/messages";
import { HOME_CONTENT } from "../../data/home";
import { routeFor } from "../../lib/routes";
import Hero from "./Hero.astro";
import Features from "./Features.astro";
import GettingStarted from "./GettingStarted.astro";
import type { Language } from "../../lib/site";
import "../../styles/home.css";

interface Props {
  language: Language;
}

const { language } = Astro.props;
const currentMessages = messages[language];
const content = HOME_CONTENT[language];
---

<ProductLayout
  language={language}
  title={content.hero.title}
  description={content.hero.description}
  section="home"
>
  <div class="home-page">
    <Hero language={language} />
    <Features language={language} />
    <GettingStarted language={language} />

    <section class="home-final-cta">
      <div>
        <p class="home-section-kicker">CodeN</p>
        <h2>{language === "zh" ? "安装后立即进入工作流" : "Install and start working immediately"}</h2>
        <p>{currentMessages.home.placeholder}</p>
      </div>
      <div class="home-final-cta-actions">
        <a class="home-button home-button--primary" href={routeFor(language, "docs")}>
          {currentMessages.home.cta.docs}
        </a>
        <a class="home-button" href={routeFor(language, "plugins")}>
          {currentMessages.home.cta.plugins}
        </a>
      </div>
      <p class="home-final-cta-command">
        <code>{currentMessages.home.installCommand}</code>
      </p>
    </section>
  </div>
</ProductLayout>
