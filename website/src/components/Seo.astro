---
import { alternateLanguagePath } from "../lib/routes";
import { SITE_ORIGIN, withBase, type Language } from "../lib/site";

interface Props {
  language: Language;
  title: string;
  description: string;
  pathname: string;
}

const { language, title, description, pathname } = Astro.props;
const canonical = new URL(pathname, SITE_ORIGIN).toString();
const zhAlternate = new URL(alternateLanguagePath(pathname, "zh"), SITE_ORIGIN).toString();
const enAlternate = new URL(alternateLanguagePath(pathname, "en"), SITE_ORIGIN).toString();
const xDefault = new URL(withBase("/"), SITE_ORIGIN).toString();
const favicon = new URL(withBase("/favicon.svg"), SITE_ORIGIN).toString();
const ogImage = new URL(withBase("/og-placeholder.svg"), SITE_ORIGIN).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={favicon} />
<link rel="alternate" hreflang="zh" href={zhAlternate} />
<link rel="alternate" hreflang="en" href={enAlternate} />
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta property="og:locale" content={language === "zh" ? "zh_CN" : "en_US"} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="CodeN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8fc" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#100b14" />
